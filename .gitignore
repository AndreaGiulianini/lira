# Lira: everything under source/build/ and production/ is regenerated by `make` in source/.
# Not tracked: caches, the Python venv, the Rust build, and what is downloaded on demand.
.DS_Store
__pycache__/
*.pyc
source/.venv/
source/build/
source/firmware/rmk/target/
source/firmware/rmk-patched/
source/firmware/rmk/*.hex
source/firmware/rmk/*.bin
source/firmware/rmk/*.uf2
# downloaded by `make` (Freerouting, SHA-256 checked) and by case/fetch_assets.py (Poly Haven, CC0)
source/tools/freerouting-*.jar
source/tools/freerouting-*.jar.part
source/assets/
# copied into the RMK project from build/firmware/ by `make firmware`
source/firmware/rmk/keyboard.toml
source/firmware/rmk/vial.json
# texts and images for posting a review request (forums, Reddit): kept locally, not in git
source/reviews/review-request.md
production/review/

# publish.py builds the new production/ here and swaps it in; left over only if publishing failed
production.new/
